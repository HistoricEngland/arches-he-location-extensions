recursive-include arches_he_location_extensions
include README.md
include LICENSE
exclude manage.py
exclude arches_he_location_extensions/settings_local.py
exclude .*
exclude *.yml
recursive-exclude .eggs *
recursive-exclude .github *
recursive-exclude .idea *
recursive-exclude node_modules *
recursive-exclude releases *
recursive-exclude tests *
recursive-exclude webpack *
recursive-exclude arches_he_location_extensions/logs *
recursive-exclude arches_he_location_extensions/staticfiles *
recursive-exclude arches_he_location_extensions/uploadedfiles *
recursive-exclude arches_he_location_extensions/media/build *
global-exclude *.log
global-exclude *.pyc
global-exclude *.zip
global-exclude *.DS_Store
global-exclude *.orig
